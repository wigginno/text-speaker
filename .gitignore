project.lock.json
# NuGet v4.0+ lock file
packages.lock.json
# NuGet package restore result
_UpgradeReport_Files/
UpgradeLog*.XML
UpgradeLog*.htm
ServiceFabricBackup/
*.snupkg

# Visual Studio Code settings
.vscode/

# Build results
*.Build.csdef

# Avalonia XAML Designer cache
.avalonia/

# Resharper files
*.DotSettings.user

# Backup & temporary files
*~
*.bak
*.tmp
*.swp
*.swo

# Do not ignore .gitignore itself
!.gitignore